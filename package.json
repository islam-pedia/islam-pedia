{
  "name": "islam-pedia",
  "version": "0.1.0",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "db:generate": "bun --bun drizzle-kit generate",
    "db:migrate": "bun --bun drizzle-kit migrate",
    "db:check": "bun --bun drizzle-kit check",
    "db:studio": "bun --bun drizzle-kit studio",
    "mcp": "bun run src/mcp/server.ts",
    "mcp:dev": "bun --watch src/mcp/server.ts",
    "db:migrate:test": "bun --env-file=.env.test.local run db:migrate",
    "typecheck": "tsc --noEmit",
    "format": "biome check --write --unsafe"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "drizzle-orm": "1.0.0-rc.4",
    "zod": "4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/bun": "latest",
    "drizzle-kit": "1.0.0-rc.4"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
